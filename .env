# ───────────────────────────────────────────────
# ICT Trading Bot  —  Environment Configuration
# ───────────────────────────────────────────────

# Exchange — Primary (crypto: Binance)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_SANDBOX=true

# Exchange — Secondary (forex/commodities/indices: OANDA)
# Sign up at https://www.oanda.com/ for a practice account
# Then get API key from https://www.oanda.com/account/tpa/personal_token
SECONDARY_EXCHANGE_ID=oanda
SECONDARY_EXCHANGE_API_KEY=
SECONDARY_EXCHANGE_SECRET=
SECONDARY_EXCHANGE_SANDBOX=true
SECONDARY_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,XAU/USD,NAS100/USD,SPX500/USD

# TradingView (optional)
TV_USERNAME=
TV_PASSWORD=
TV_ENABLED=true

# Timeframes (3-tier MTFA)
DEFAULT_TIMEFRAME=15m
HIGHER_TIMEFRAME=4h
SWING_TIMEFRAME=4h
HTF_TF=4h
MTF_TF=15m
LTF_TF=5m

# Risk Management
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_TRADES=3
DEFAULT_RR_RATIO=3.0

# Symbols
FOREX_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,XAU/USD,NAS100/USD,SPX500/USD
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,PAXG/USDT

# Dashboard
DASHBOARD_PORT=8501
