# ============================================================
# TRADING BOT CONFIGURATION
# Copy this to .env and fill in your actual credentials
# NEVER commit .env to version control
# ============================================================

# -- Exchange API (for live/paper trading) --
# Supported: binance, bybit, kraken, coinbase
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here
EXCHANGE_SANDBOX=true

# -- TradingView (optional, for chart data) --
TV_USERNAME=
TV_PASSWORD=

# -- Trading parameters --
DEFAULT_TIMEFRAME=15m
HIGHER_TIMEFRAME=1h
SWING_TIMEFRAME=4h

# -- Risk management --
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_TRADES=3
DEFAULT_RR_RATIO=3.0

# -- Symbols to track --
FOREX_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,GBP/JPY,EUR/GBP
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# -- Dashboard --
DASHBOARD_PORT=8501
